<ui:FluentWindow
    x:Class="Lab_Feedback_WPF.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:avalon="http://icsharpcode.net/sharpdevelop/avalonedit"
    xmlns:vm="clr-namespace:Lab_Feedback_WPF.ViewModels"
    xmlns:views="clr-namespace:Lab_Feedback_WPF.Views"
    Title="Lab Feedback" Height="800" Width="1200">

    <ui:FluentWindow.Resources>

        <CollectionViewSource x:Key="GroupedStudents" Source="{Binding Students}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Section"/>
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>

        <Style x:Key="CompactListBoxItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="4,2"/>
            <EventSetter Event="PreviewMouseRightButtonDown"
                         Handler="ListBoxItem_PreviewMouseRightButtonDown"/>
        </Style>

        <Style x:Key="StatusLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#999999"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="StatusValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="StatusSeparatorStyle" TargetType="Separator">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Background" Value="#3F3F46"/>
            <Setter Property="Margin" Value="8,2"/>
        </Style>

        <!-- File tab button style -->
        <Style x:Key="FileTabButtonStyle" TargetType="Button">
            <Setter Property="Margin" Value="2,0,2,0"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#272822"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3F3F46"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- File tab DataTemplate -->
        <DataTemplate DataType="{x:Type vm:FileTabViewModel}">
            <Button Content="{Binding FileName}"
                    Command="{Binding DataContext.SelectTabCommand,
                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                    CommandParameter="{Binding}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource FileTabButtonStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="Background"
                                        Value="#FFFFFF28"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </DataTemplate>

    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title Bar -->
        <ui:TitleBar Grid.Row="0" Title="Lab Feedback">
            <ui:TitleBar.Header>
                <Menu>
                    <MenuItem Header="File">
                        <MenuItem Header="Open Folder" Command="{Binding OpenFolderCommand}"/>
                        <MenuItem Header="Refresh" Command="{Binding RefreshCommand}"/>
                        <Separator/>
                        <MenuItem Header="Exit" Command="{Binding ExitCommand}"/>
                    </MenuItem>
                    <MenuItem Header="View">
                        <MenuItem Header="Grade Overview"
                                  IsCheckable="True"
                                  IsChecked="{Binding IsGradeOverviewVisible, Mode=TwoWay}"/>
                    </MenuItem>
                </Menu>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition x:Name="sidePanelColumn" Width="0"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel: Students + Assignments -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0">
                    <DockPanel DockPanel.Dock="Top" Margin="5,2,2,4">
                        <TextBlock Text="STUDENTS" Foreground="#999999"
                                   VerticalAlignment="Center"
                                   FontWeight="Bold" FontSize="11"/>
                        <Button DockPanel.Dock="Right"
                                Command="{Binding RefreshCommand}"
                                ToolTip="Refresh (reload folders and grade sheets)"
                                Width="22" Height="22"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                HorizontalAlignment="Right">
                            <TextBlock Text="&#xE72C;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="12"
                                       Foreground="#999999"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Button>
                    </DockPanel>
                    <ListBox x:Name="listBoxStudents"
                             ItemsSource="{Binding Source={StaticResource GroupedStudents}}"
                             SelectedItem="{Binding SelectedStudent, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource CompactListBoxItem}"
                             Margin="5,0,5,0"
                             Foreground="#FF999999">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding FullName}" FontSize="12" Foreground="#999999"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.ContainerStyle>
                                    <Style TargetType="{x:Type GroupItem}">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="{x:Type GroupItem}">
                                                    <Expander IsExpanded="True"
                                                              Foreground="#999999"
                                                              Margin="0,4,0,0">
                                                        <Expander.Header>
                                                            <TextBlock Text="{Binding Name}"
                                                                       FontWeight="Bold"
                                                                       FontSize="11"
                                                                       Foreground="#999999"/>
                                                        </Expander.Header>
                                                        <ItemsPresenter/>
                                                    </Expander>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </GroupStyle.ContainerStyle>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Open in File Explorer"
                                          Command="{Binding PlacementTarget.DataContext.OpenStudentInExplorerCommand,
                                                            RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                <MenuItem Header="Copy Student Name and ID Number"
                                          Command="{Binding PlacementTarget.DataContext.CopyStudentInfoCommand,
                                                            RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                    </ListBox>
                </DockPanel>

                <GridSplitter Height="1" Grid.Row="1" HorizontalAlignment="Stretch" Background="#3F3F46"/>

                <DockPanel Grid.Row="2">
                    <TextBlock DockPanel.Dock="Top" Text="ASSIGNMENTS" Foreground="#999999"
                               Margin="5,4,5,4" FontWeight="Bold" FontSize="11"/>
                    <ListBox x:Name="listBoxAssignments"
                             ItemsSource="{Binding Assignments}"
                             SelectedItem="{Binding SelectedAssignment, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource CompactListBoxItem}"
                             Margin="5,0,5,0"
                             Foreground="#FF999999">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" FontSize="12" Foreground="#999999"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Open in File Explorer"
                                          Command="{Binding PlacementTarget.DataContext.OpenAssignmentInExplorerCommand,
                                                            RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                    </ListBox>
                </DockPanel>
            </Grid>

            <GridSplitter Grid.Column="1" Width="1" HorizontalAlignment="Stretch" Background="#3F3F46"/>

            <!-- Center: Code View -->
            <DockPanel Grid.Column="2">

                <!-- Tab bar -->
                <DockPanel DockPanel.Dock="Top" Background="#272822">
                    <Button x:Name="buttonOpenGrading"
                            DockPanel.Dock="Right"
                            Width="28" Height="28"
                            Padding="0"
                            ToolTip="Open Grading Panel"
                            Command="{Binding ToggleSidePanelCommand}"
                            Background="#272822"
                            BorderThickness="0"
                            VerticalAlignment="Center">
                        <TextBlock Text="&#xE762;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="14"
                                   Foreground="#999999"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Button>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding FileTabs}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Background="#272822"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>

                <!-- Editor area -->
                <Grid>
                    <avalon:TextEditor
                        x:Name="codeEditor"
                        FontFamily="Consolas"
                        FontSize="13"
                        IsReadOnly="True"
                        ShowLineNumbers="True"
                        Background="#272822"
                        Foreground="#F8F8F2"/>

                    <!-- Empty state overlay -->
                    <Border x:Name="emptyStateOverlay"
                            Background="#272822">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEmptyState}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Opacity="0.4">
                            <TextBlock Text="&#xE8A5;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="48"
                                       HorizontalAlignment="Center"
                                       Foreground="#F8F8F2"
                                       Margin="0,0,0,16"/>
                            <TextBlock Text="No file selected"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       Foreground="#F8F8F2"
                                       Margin="0,0,0,8"/>
                            <TextBlock Text="1. Select a student from the list"
                                       FontSize="13"
                                       HorizontalAlignment="Center"
                                       Foreground="#F8F8F2"
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="2. Select an assignment to view its code"
                                       FontSize="13"
                                       HorizontalAlignment="Center"
                                       Foreground="#F8F8F2"/>
                        </StackPanel>
                    </Border>

                    <!-- Grade Overview overlay -->
                    <Border x:Name="gradeOverviewOverlay">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsGradeOverviewVisible}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <views:GradeOverviewView DataContext="{Binding GradeOverviewVM}"/>
                    </Border>
                </Grid>
            </DockPanel>

            <GridSplitter x:Name="sidePanelSplitter"
                          Grid.Column="3"
                          Width="5"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="#3F3F46"
                          Visibility="Collapsed"/>

            <!-- Side Panel -->
            <Border x:Name="sidePanelContent"
                    Grid.Column="4"
                    Background="#1E1E1E"
                    BorderBrush="#3F3F46"
                    BorderThickness="1,0,0,0">
                <ContentPresenter x:Name="sidePanelPresenter"/>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2"
                Height="24"
                Background="#2D2D30"
                BorderBrush="#3F3F46"
                BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="15,0,15,3">

                <TextBlock Text="Builds: " Style="{StaticResource StatusLabelStyle}"/>
                <TextBlock Text="{Binding StatusBuilds}" Style="{StaticResource StatusValueStyle}"/>

                <Separator Style="{StaticResource StatusSeparatorStyle}"/>

                <TextBlock Text="Score: " Style="{StaticResource StatusLabelStyle}"/>
                <TextBlock Text="{Binding StatusScore}" Style="{StaticResource StatusValueStyle}"/>

                <Separator Style="{StaticResource StatusSeparatorStyle}"/>

                <TextBlock Text="Violations: " Style="{StaticResource StatusLabelStyle}"/>
                <TextBlock x:Name="statusViolations"
                           Text="{Binding ViolationCount}"
                           Foreground="{Binding ViolationColor}"
                           FontSize="11"
                           VerticalAlignment="Center"
                           ToolTipService.ShowDuration="30000"
                           ToolTipService.InitialShowDelay="500">
                    <TextBlock.ToolTip>
                        <ToolTip>
                            <TextBlock Text="{Binding ViolationTooltip}"
                                       FontFamily="Consolas"
                                       MaxWidth="600"
                                       TextWrapping="Wrap"/>
                        </ToolTip>
                    </TextBlock.ToolTip>
                </TextBlock>

            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
