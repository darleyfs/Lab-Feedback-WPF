<ui:FluentWindow
    x:Class="Lab_Feedback_WPF.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:avalon="http://icsharpcode.net/sharpdevelop/avalonedit"
    Title="Lab Feedback" Height="800" Width="1200">

    <ui:FluentWindow.Resources>
        <Style x:Key="CompactListBoxItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="4,2"/>
            <EventSetter Event="PreviewMouseRightButtonDown"
                         Handler="ListBoxItem_PreviewMouseRightButtonDown"/>
        </Style>

        <Style x:Key="SidePanelTabStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="72"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#999999"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border"
                        Background="{TemplateBinding Background}"
                        BorderThickness="2,0,0,0"
                        BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#007ACC"/>
                                <Setter TargetName="border" Property="Background" Value="#1E1E1E"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3F3F46"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StatusLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#999999"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="StatusValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="StatusSeparatorStyle" TargetType="Separator">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Background" Value="#3F3F46"/>
            <Setter Property="Margin" Value="8,2"/>
        </Style>

        <!-- Violations Panel -->
        <Border x:Key="ViolationsPanel" Background="#1E1E1E" Padding="8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top"
                    Text="Violations"
                    FontWeight="SemiBold"
                    FontSize="13"
                    Foreground="#CCCCCC"
                    Margin="0,0,0,8"/>
                <ListView x:Name="violationsList"
                    Background="Transparent"
                    BorderThickness="0"
                    Foreground="#CCCCCC"
                    FontFamily="Consolas"
                    FontSize="12"/>
            </DockPanel>
        </Border>

        <!-- File Info Panel -->
        <Border x:Key="FileInfoPanel" Background="#1E1E1E" Padding="8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top"
                    Text="File Info"
                    FontWeight="SemiBold"
                    FontSize="13"
                    Foreground="#CCCCCC"
                    Margin="0,0,0,8"/>
                <StackPanel x:Name="fileInfoStack">
                    <TextBlock x:Name="fileInfoName"
                        Foreground="#CCCCCC"
                        FontSize="12"
                        TextWrapping="Wrap"/>
                    <TextBlock x:Name="fileInfoPath"
                        Foreground="#666666"
                        FontSize="11"
                        TextWrapping="Wrap"
                        Margin="0,4,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- TitleBar -->
            <RowDefinition Height="*"/>
            <!-- Content -->
            <RowDefinition Height="Auto"/>
            <!-- StatusBar -->
        </Grid.RowDefinitions>

        <!-- Title Bar (replaces your custom titleBar panel) -->
        <ui:TitleBar Grid.Row="0" Title="Lab Feedback">
            <ui:TitleBar.Header>
                <Menu>
                    <MenuItem Header="File">
                        <MenuItem Header="Open Folder" Click="OpenFolderMenuItem_Click"/>
                        <Separator/>
                        <MenuItem Header="Exit" Click="ExitMenuItem_Click"/>
                    </MenuItem>
                </Menu>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <!-- Main Content (replaces your SplitContainers) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition x:Name="sidePanelColumn" Width="0"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel: Students + Assignments -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0">
                    <TextBlock DockPanel.Dock="Top" Text="STUDENTS" Foreground="#999999"
                               Margin="5,4,5,4" FontWeight="Bold" FontSize="11"/>
                    <ListBox x:Name="listBoxStudents"
                             ItemContainerStyle="{StaticResource CompactListBoxItem}"
                             SelectionChanged="ListBoxStudents_SelectionChanged" Margin="5,0,5,0" 
                             Foreground="#FF999999">

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding FullName}"
                               FontSize="12"
                               Foreground="#999999"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>

                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Open in File Explorer" 
                                    Click="OpenInFileExplorer_Click"/>
                                <MenuItem Header="Copy Student Name and ID Number" 
                                    Click="CopyStudentNameAndNumber_Click"/>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                    </ListBox>
                </DockPanel>

                <GridSplitter 
                    Height="1"
                    Grid.Row="1" 
                    HorizontalAlignment="Stretch"
                    Background="#3F3F46"/>

                <DockPanel Grid.Row="2">
                    <TextBlock 
                        DockPanel.Dock="Top" Text="ASSIGNMENTS" Foreground="#999999"
                        Margin="5,4,5,4" FontWeight="Bold" FontSize="11"/>
                    <ListBox x:Name="listBoxAssignments"
                         ItemContainerStyle="{StaticResource CompactListBoxItem}"
                         SelectionChanged="ListBoxAssignments_SelectionChanged" Margin="5,0,5,0" 
                         Foreground="#FF999999">

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}"
                               FontSize="12"
                               Foreground="#999999"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>

                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Open in File Explorer"
                                    Click="OpenAssignmentInFileExplorer_Click"/>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                    </ListBox>
                </DockPanel>
            </Grid>
            
            <GridSplitter 
                Grid.Column="1" 
                Width="1"
                HorizontalAlignment="Stretch"
                Background="#3F3F46" />

            <!-- Right Panel: Code View -->
            <DockPanel Grid.Column="2">
                <DockPanel DockPanel.Dock="Top" Background="#272822">

                    <Button x:Name="buttonOpenGrading"
                        DockPanel.Dock="Right"
                        Width="28"
                        Height="28"
                        Padding="0"
                        ToolTip="Open Grading Panel"
                        Click="ButtonOpenGrading_Click"
                        Background="#272822"
                        BorderThickness="0"
                        VerticalAlignment="Center">
                        
                        <TextBlock Text="&#xE762;"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="14"
                           Foreground="#999999"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
                    </Button>

                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="panelFileTabs" Orientation="Horizontal" Background="#272822"/>
                    </ScrollViewer>

                </DockPanel>

                <Grid>
                    <avalon:TextEditor
                        x:Name="codeEditor"
                        FontFamily="Consolas"
                        FontSize="13"
                        IsReadOnly="True"
                        ShowLineNumbers="True"
                        Background="#272822"
                        Foreground="#F8F8F2"/>

                    <Border x:Name="emptyStateOverlay"
                        Background="#272822"
                        Visibility="Visible">
                        <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Opacity="0.4">
                            <TextBlock Text="&#xE8A5;"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="48"
                           HorizontalAlignment="Center"
                           Foreground="#F8F8F2"
                           Margin="0,0,0,16"/>
                            <TextBlock Text="No file selected"
                           FontSize="18"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Foreground="#F8F8F2"
                           Margin="0,0,0,8"/>
                            <TextBlock Text="1. Select a student from the list"
                           FontSize="13"
                           HorizontalAlignment="Center"
                           Foreground="#F8F8F2"
                           Margin="0,0,0,4"/>
                            <TextBlock Text="2. Select an assignment to view its code"
                           FontSize="13"
                           HorizontalAlignment="Center"
                           Foreground="#F8F8F2"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </DockPanel>

            <GridSplitter x:Name="sidePanelSplitter"
              Grid.Column="3"
              Width="5"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"
              Background="#3F3F46"
              Visibility="Collapsed"/>

            <!-- Side Panel Content -->
            <Border x:Name="sidePanelContent"
                Grid.Column="4"
                Background="#1E1E1E"
                BorderBrush="#3F3F46"
                BorderThickness="1,0,0,0">
                <ContentPresenter x:Name="sidePanelPresenter"/>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2"
        Height="24"
        Background="#2D2D30"
        BorderBrush="#3F3F46"
        BorderThickness="0,1,0,0">
            <StackPanel 
                Orientation="Horizontal"
                VerticalAlignment="Center"
                Margin="15,0,15,3">

                <TextBlock Text="Builds: " Style="{StaticResource StatusLabelStyle}"/>
                <TextBlock x:Name="statusBuilds" Text="0" Style="{StaticResource StatusValueStyle}"/>

                <Separator Style="{StaticResource StatusSeparatorStyle}"/>

                <TextBlock Text="Score: " Style="{StaticResource StatusLabelStyle}"/>
                <TextBlock x:Name="statusScore" Text="0" Style="{StaticResource StatusValueStyle}"/>

                <Separator Style="{StaticResource StatusSeparatorStyle}"/>

                <TextBlock Text="Violations: " Style="{StaticResource StatusLabelStyle}"/>
                <TextBlock x:Name="statusViolations"
                   Text="0"
                   Style="{StaticResource StatusValueStyle}"
                   ToolTipService.ShowDuration="30000"
                   ToolTipService.InitialShowDelay="500"/>
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>