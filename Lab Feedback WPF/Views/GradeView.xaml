<UserControl x:Class="Lab_Feedback_WPF.Views.GradingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Background="#1E1E1E">

    <DockPanel>

        <!-- Header -->
        <Border DockPanel.Dock="Top"
                Background="#252526"
                Padding="12,8"
                BorderBrush="#3F3F46"
                BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="copyFeedbackButton"
                            Content="Copy Feedback"
                            Click="CopyFeedbackButton_Click"
                            Padding="8,4"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center"/>
                    <TextBlock Text="Total: "
                               Foreground="#CCCCCC"
                               FontSize="13"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="totalScore"
                               Foreground="#A6E22E"
                               FontSize="13"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="totalPossible"
                               Foreground="#666666"
                               FontSize="13"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="labTitle"
                           Foreground="#CCCCCC"
                           FontSize="14"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- Scrollable content area -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Full placeholder — shown when no project selected -->
                <StackPanel x:Name="placeholderPanel"
                            Visibility="Visible"
                            HorizontalAlignment="Center"
                            Opacity="0.4"
                            Margin="0,60,0,0">
                    <TextBlock Text="&#xE9CE;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="40"
                               HorizontalAlignment="Center"
                               Foreground="#F8F8F2"
                               Margin="0,0,0,12"/>
                    <TextBlock x:Name="placeholderMessage"
                               Text="Select a student and assignment to begin grading."
                               FontSize="13"
                               HorizontalAlignment="Center"
                               Foreground="#F8F8F2"
                               FontStyle="Italic"/>
                </StackPanel>

                <!-- Header controls — visible when a project is selected -->
                <StackPanel x:Name="headerPanel"
                            Margin="8"
                            Visibility="Collapsed">

                    <!-- Student Name -->
                    <TextBlock Text="Student Name"
                               Foreground="#666666"
                               FontSize="11"
                               Margin="0,0,0,4"/>
                    <TextBox x:Name="studentNameBox"
                             Background="#252526"
                             Foreground="#F8F8F2"
                             BorderBrush="#3F3F46"
                             Padding="8,6"
                             FontSize="13"
                             Margin="0,0,0,12"/>

                    <!-- Initial Remarks -->
                    <Expander x:Name="remarksExpander"
                              Header="Initial Remarks (HTML)"
                              Foreground="#CCCCCC"
                              Margin="0,0,0,12"
                              IsExpanded="True">
                        <TextBox x:Name="remarksBox"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="60"
                                 Background="#1A1A1A"
                                 Foreground="#F8F8F2"
                                 BorderBrush="#3F3F46"
                                 Padding="8"
                                 FontFamily="Consolas"
                                 FontSize="12"
                                 Margin="0,4,0,0"/>
                    </Expander>

                    <!-- Deductions -->
                    <StackPanel x:Name="deductionsPanel" Margin="0,0,0,12"/>

                    <!-- Divider — only shown when results are present -->
                    <Border x:Name="resultsDivider"
                            BorderBrush="#3F3F46"
                            BorderThickness="0,1,0,0"
                            Margin="0,0,0,12"
                            Visibility="Collapsed"/>

                </StackPanel>

                <!-- Results area -->
                <StackPanel x:Name="resultsPanel"
                            Margin="8,0,8,8"
                            Visibility="Collapsed">

                    <!-- No results message -->
                    <TextBlock x:Name="noResultsMessage"
                               Text="Results file not found."
                               FontSize="12"
                               FontStyle="Italic"
                               Foreground="#666666"
                               HorizontalAlignment="Center"
                               Margin="0,8,0,0"
                               Visibility="Collapsed"/>

                    <!-- Dynamic test cards inserted here by code-behind -->
                    <StackPanel x:Name="testCardsPanel"/>

                </StackPanel>

            </StackPanel>
        </ScrollViewer>

    </DockPanel>
</UserControl>