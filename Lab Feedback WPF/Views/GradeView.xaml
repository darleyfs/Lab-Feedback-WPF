<UserControl x:Class="Lab_Feedback_WPF.Views.GradingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:Lab_Feedback_WPF.ViewModels"
             Background="#1E1E1E">

    <UserControl.Resources>

        <!-- ── Deduction row ─────────────────────────────────────────────── -->
        <DataTemplate DataType="{x:Type vm:DeductionViewModel}">
            <DockPanel Margin="0,0,16,6" IsEnabled="{Binding IsEnabled}">
                <CheckBox DockPanel.Dock="Left"
                          IsChecked="{Binding IsApplied}"
                          VerticalAlignment="Center"
                          Margin="0,0,8,0"/>
                <TextBlock DockPanel.Dock="Right"
                           Text="{Binding PointsText}"
                           VerticalAlignment="Center"
                           FontFamily="Consolas"
                           FontSize="12"
                           Margin="8,0,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#646464"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsApplied}" Value="True">
                                    <Setter Property="Foreground" Value="#F9266E"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding Label}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Foreground="#B4B4B4"/>
            </DockPanel>
        </DataTemplate>

        <!-- ── Test result card ──────────────────────────────────────────── -->
        <DataTemplate DataType="{x:Type vm:TestResultViewModel}">
            <Border Margin="0,0,2,8" Padding="12">
                <StackPanel>

                    <!-- Header: indicator + name -->
                    <DockPanel Margin="0,0,0,4">
                        <Border DockPanel.Dock="Left"
                                Width="8" Height="8"
                                CornerRadius="4"
                                Background="{Binding IndicatorColor}"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Name}"
                                   Foreground="#F8F8F2"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </DockPanel>

                    <!-- Description -->
                    <TextBlock Text="{Binding DisplayDescription}"
                               FontSize="11"
                               Margin="16,0,0,8"
                               TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#B4B4B4"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasDescription}" Value="False">
                                        <Setter Property="Foreground" Value="#505050"/>
                                        <Setter Property="FontStyle" Value="Italic"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Score row: indicator + slider + textbox + total -->
                    <DockPanel Margin="0,0,0,4">
                        <TextBox DockPanel.Dock="Right"
                                 Width="60"
                                 Text="{Binding GradedPoints, StringFormat=F2, UpdateSourceTrigger=LostFocus}"
                                 Background="#1E1E1E"
                                 Foreground="#F8F8F2"
                                 BorderBrush="#3F3F46"
                                 Padding="4,2"
                                 FontFamily="Consolas"
                                 VerticalContentAlignment="Center"/>
                        <TextBlock DockPanel.Dock="Right"
                                   Text="{Binding PointsTotalText}"
                                   Foreground="#646464"
                                   FontFamily="Consolas"
                                   VerticalAlignment="Center"/>
                        <Border DockPanel.Dock="Left"
                                Width="8" Height="8"
                                CornerRadius="4"
                                Background="{Binding IndicatorColor}"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"/>
                        <Slider Value="{Binding GradedPoints, Mode=TwoWay}"
                                Minimum="0"
                                Maximum="{Binding PointsTotal}"
                                IsSnapToTickEnabled="False"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"/>
                    </DockPanel>

                    <!-- Comments expander -->
                    <Expander Header="Comments (HTML)"
                              Foreground="#969696"
                              Margin="0,4,0,0"
                              IsExpanded="{Binding HasComments, Mode=OneTime}">
                        <TextBox Text="{Binding Comments, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="60"
                                 Background="#1A1A1A"
                                 Foreground="#F8F8F2"
                                 BorderBrush="#3F3F46"
                                 Padding="8"
                                 FontFamily="Consolas"
                                 FontSize="12"
                                 Margin="0,4,0,0"/>
                    </Expander>

                </StackPanel>
            </Border>
        </DataTemplate>

    </UserControl.Resources>

    <DockPanel>

        <!-- Header -->
        <Border DockPanel.Dock="Top"
                Background="#252526"
                Padding="12,8"
                BorderBrush="#3F3F46"
                BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="copyFeedbackButton"
                            Content="Copy Feedback"
                            Command="{Binding CopyFeedbackCommand}"
                            Padding="8,4"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center"/>
                    <TextBlock Text="Total: "
                               Foreground="#CCCCCC"
                               FontSize="13"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding TotalScore}"
                               Foreground="{Binding TotalScoreColor}"
                               FontSize="13"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding TotalPossible}"
                               Foreground="#666666"
                               FontSize="13"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="{Binding LabTitle}"
                           Foreground="#CCCCCC"
                           FontSize="14"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- Scrollable content -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Placeholder (no project selected) -->
                <StackPanel HorizontalAlignment="Center"
                            Opacity="0.4"
                            Margin="0,60,0,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPlaceholderVisible}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="&#xE9CE;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="40"
                               HorizontalAlignment="Center"
                               Foreground="#F8F8F2"
                               Margin="0,0,0,12"/>
                    <TextBlock Text="Select a student and assignment to begin grading."
                               FontSize="13"
                               HorizontalAlignment="Center"
                               Foreground="#F8F8F2"
                               FontStyle="Italic"/>
                </StackPanel>

                <!-- Content (project selected) -->
                <StackPanel Margin="8">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsContentVisible}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <!-- Student name -->
                    <TextBlock Text="Student Name"
                               Foreground="#666666"
                               FontSize="11"
                               Margin="0,0,0,4"/>
                    <TextBox x:Name="studentNameBox"
                             Text="{Binding StudentName}"
                             Background="#252526"
                             Foreground="#F8F8F2"
                             BorderBrush="#3F3F46"
                             Padding="8,6"
                             FontSize="13"
                             Margin="0,0,0,12"
                             IsEnabled="{Binding ControlsEnabled}"/>

                    <!-- Remarks (AvalonEdit inserted by code-behind into this expander) -->
                    <Expander x:Name="remarksExpander"
                              Header="Initial Remarks (HTML)"
                              Foreground="#CCCCCC"
                              Margin="0,0,0,12"
                              IsExpanded="True"
                              IsEnabled="{Binding ControlsEnabled}"/>

                    <!-- Deductions -->
                    <ItemsControl ItemsSource="{Binding Deductions}" Margin="0,0,0,12"/>

                    <!-- Divider (only when results present) -->
                    <Border BorderBrush="#3F3F46"
                            BorderThickness="0,1,0,0"
                            Margin="0,0,0,12">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasResults}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>

                </StackPanel>

                <!-- No results message -->
                <TextBlock Text="Results file not found."
                           FontSize="12"
                           FontStyle="Italic"
                           Foreground="#666666"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding NoResultsVisible}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Test cards -->
                <ItemsControl ItemsSource="{Binding TestResults}"
                              Margin="8,0,8,8"
                              IsEnabled="{Binding ControlsEnabled}"/>

            </StackPanel>
        </ScrollViewer>

    </DockPanel>
</UserControl>
