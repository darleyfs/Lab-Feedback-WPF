<ui:FluentWindow
    x:Class="Lab_Feedback_WPF.Views.ExtractionProgressDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Extracting Files"
    Width="420"
    SizeToContent="Height"
    MaxHeight="600"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner"
    Closing="ExtractionProgressDialog_Closing">

    <DockPanel Margin="16">

        <!-- Header -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock x:Name="activeCountLabel"
                       Text="0 Active Extractions"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="#CCCCCC"
                       VerticalAlignment="Center"/>
        </DockPanel>

        <!-- Scrollable list of progress items -->
        <ScrollViewer DockPanel.Dock="Top"
                      VerticalScrollBarVisibility="Auto"
                      MaxHeight="480">
            <StackPanel x:Name="progressItemsPanel"/>
        </ScrollViewer>

        <!-- Cancel All button -->
        <Button x:Name="cancelAllButton"
                DockPanel.Dock="Bottom"
                Content="Cancel All"
                HorizontalAlignment="Right"
                Width="90"
                Height="26"
                Margin="0,12,0,0"
                Click="CancelAllButton_Click"/>

    </DockPanel>
</ui:FluentWindow>