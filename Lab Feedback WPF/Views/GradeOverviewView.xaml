<UserControl x:Class="Lab_Feedback_WPF.Views.GradeOverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:Lab_Feedback_WPF.Models"
             Background="#272822">

    <UserControl.Resources>

        <Style x:Key="SummaryLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#999999"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="SummaryValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="4,0,16,0"/>
        </Style>

        <!-- Check-status glyph: green check when found, amber warning when missing -->
        <Style x:Key="CheckGlyphStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="3,0,2,0"/>
        </Style>

        <!-- Templated glyph bound to a bool "found" property; use with a Binding on the target property -->
        <Style x:Key="FoundGlyphStyle" TargetType="TextBlock" BasedOn="{StaticResource CheckGlyphStyle}">
            <Setter Property="Text" Value="&#xE73E;"/>
            <Setter Property="Foreground" Value="#98C379"/>
        </Style>

        <!-- Subtle semi-transparent highlight tints, blended over the dark background -->
        <SolidColorBrush x:Key="PassingRowBrush" Color="#98C379" Opacity="0.10"/>
        <SolidColorBrush x:Key="TbdRowBrush" Color="#E5C07B" Opacity="0.10"/>
        <SolidColorBrush x:Key="FailingRowBrush" Color="#E06C75" Opacity="0.12"/>
        <SolidColorBrush x:Key="RescheduledRowBrush" Color="#C678DD" Opacity="0.12"/>

        <!-- Row style: passing green, TBD yellow, failing + not on list red, failing + on list purple;
             inactive rows keep the plain background with faded text -->
        <Style x:Key="GradeRowStyle" TargetType="DataGridRow">
            <Setter Property="Foreground" Value="#F8F8F2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static models:GradeStatus.Passing}">
                    <Setter Property="Background" Value="{StaticResource PassingRowBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static models:GradeStatus.TBD}">
                    <Setter Property="Background" Value="{StaticResource TbdRowBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static models:GradeStatus.Failing}">
                    <Setter Property="Background" Value="{StaticResource FailingRowBrush}"/>
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Status}" Value="{x:Static models:GradeStatus.Failing}"/>
                        <Condition Binding="{Binding AlreadyRescheduled}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{StaticResource RescheduledRowBrush}"/>
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static models:GradeStatus.Inactive}">
                    <Setter Property="Foreground" Value="#75715E"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Summary counts: green at zero, otherwise red (Need Rescheduling) or yellow (TBD / pending) -->
        <Style x:Key="NeedRescheduleValueStyle" TargetType="TextBlock" BasedOn="{StaticResource SummaryValueStyle}">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#E06C75"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding NeedRescheduling}" Value="0">
                    <Setter Property="Foreground" Value="#98C379"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PendingValueStyle" TargetType="TextBlock" BasedOn="{StaticResource SummaryValueStyle}">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#E5C07B"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding TBD}" Value="0">
                    <Setter Property="Foreground" Value="#98C379"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <DockPanel>

        <!-- Header -->
        <Border DockPanel.Dock="Top"
                Background="#252526"
                Padding="12,8"
                BorderBrush="#3F3F46"
                BorderThickness="0,0,0,1">
            <DockPanel>
                <Button DockPanel.Dock="Right"
                        Content="Copy Needing Reschedule"
                        Command="{Binding CopyNeedRescheduleCommand}"
                        Padding="8,4"
                        VerticalAlignment="Center"
                        ToolTip="Disabled when no students need rescheduling"
                        ToolTipService.ShowOnDisabled="True"/>

                <Button DockPanel.Dock="Right"
                        Content="Copy Selected"
                        Command="{Binding CopySelectedCommand}"
                        CommandParameter="{Binding SelectedItems, ElementName=gradeDataGrid}"
                        Padding="8,4"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        ToolTip="Copy the selected rows regardless of reschedule status (Ctrl+C)"
                        ToolTipService.ShowOnDisabled="True"/>

                <TextBlock DockPanel.Dock="Right"
                           Text="{Binding CopyStatus}"
                           Style="{StaticResource SummaryLabelStyle}"
                           Margin="0,0,8,0"/>

                <TextBox DockPanel.Dock="Right"
                         Text="{Binding Instructor, UpdateSourceTrigger=PropertyChanged}"
                         Width="160"
                         Margin="0,0,8,0"
                         VerticalAlignment="Center"
                         ToolTip="Filled into the Instructor column when copying reschedule rows"/>
                <TextBlock DockPanel.Dock="Right"
                           Text="Instructor: "
                           Style="{StaticResource SummaryLabelStyle}"/>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Total: " Style="{StaticResource SummaryLabelStyle}"/>
                    <TextBlock Text="{Binding Total}" Style="{StaticResource SummaryValueStyle}"/>

                    <TextBlock Text="Failing: " Style="{StaticResource SummaryLabelStyle}"/>
                    <TextBlock Text="{Binding Failing}" Style="{StaticResource SummaryValueStyle}"/>

                    <TextBlock Text="Passing: " Style="{StaticResource SummaryLabelStyle}"/>
                    <TextBlock Text="{Binding Passing}" Style="{StaticResource SummaryValueStyle}"/>

                    <TextBlock Text="TBD: " Style="{StaticResource SummaryLabelStyle}"/>
                    <TextBlock Text="{Binding TBD}" Style="{StaticResource PendingValueStyle}"/>

                    <TextBlock Text="Inactive: " Style="{StaticResource SummaryLabelStyle}"/>
                    <TextBlock Text="{Binding Inactive}" Style="{StaticResource SummaryValueStyle}"/>

                    <TextBlock Text="Already Rescheduled: " Style="{StaticResource SummaryLabelStyle}"/>
                    <TextBlock Text="{Binding AlreadyRescheduled}" Style="{StaticResource SummaryValueStyle}"/>

                    <TextBlock Text="Need Rescheduling: " Style="{StaticResource SummaryLabelStyle}"/>
                    <TextBlock Text="{Binding NeedRescheduling}" Style="{StaticResource NeedRescheduleValueStyle}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Gradebook (per-section) and reschedule-list (class-wide) check status -->
        <Border DockPanel.Dock="Top"
                Padding="12,6"
                Background="#2D2D30"
                BorderBrush="#3F3F46"
                BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">

                <!-- Class-wide reschedule list check -->
                <Border Background="#1E1E1E" CornerRadius="3" Padding="6,3" Margin="0,0,12,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource FoundGlyphStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RescheduleFileFound}" Value="False">
                                            <Setter Property="Text" Value="&#xE7BA;"/>
                                            <Setter Property="Foreground" Value="#E5C07B"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="Reschedule List"
                                   FontSize="10"
                                   Foreground="#999999"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Per-section gradebook check -->
                <ItemsControl ItemsSource="{Binding SectionChecks}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:SectionCheckStatus}">
                            <Border Background="#1E1E1E" CornerRadius="3" Padding="6,3" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Section}"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="#CCCCCC"
                                               VerticalAlignment="Center"/>

                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource FoundGlyphStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding GradebookFound}" Value="False">
                                                        <Setter Property="Text" Value="&#xE7BA;"/>
                                                        <Setter Property="Foreground" Value="#E5C07B"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="Gradebook"
                                               FontSize="10"
                                               Foreground="#999999"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Table -->
        <DataGrid x:Name="gradeDataGrid"
                  ItemsSource="{Binding Records}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserSortColumns="True"
                  CanUserAddRows="False"
                  SelectionMode="Extended"
                  SelectionUnit="FullRow"
                  GridLinesVisibility="Horizontal"
                  Background="#272822"
                  Foreground="#F8F8F2"
                  BorderThickness="0"
                  RowStyle="{StaticResource GradeRowStyle}">
            <!-- Ctrl+C copies selected rows in reschedule-sheet format instead of the default cell copy -->
            <DataGrid.InputBindings>
                <KeyBinding Key="C" Modifiers="Control"
                            Command="{Binding CopySelectedCommand}"
                            CommandParameter="{Binding SelectedItems, ElementName=gradeDataGrid}"/>
            </DataGrid.InputBindings>
            <!-- A ContextMenu lives outside the visual tree, so ElementName can't reach the grid;
                 go through PlacementTarget instead -->
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Copy Selected (Reschedule Rows)"
                              InputGestureText="Ctrl+C"
                              Command="{Binding CopySelectedCommand}"
                              CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Section" Binding="{Binding Section}" Width="70"/>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="180"/>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="110"/>
                <DataGridTextColumn Header="Campus/Online" Binding="{Binding Modality}" Width="110"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80"/>
                <DataGridTextColumn Header="Actual Grade" Binding="{Binding ActualGrade, StringFormat=F1}" Width="100"/>
                <DataGridTextColumn Header="Best Possible" Binding="{Binding BestPossible, StringFormat=F1}" Width="100"/>
                <DataGridTextColumn Header="Reschedule Status" Binding="{Binding RescheduleStatusText}" Width="140"/>
            </DataGrid.Columns>
        </DataGrid>

    </DockPanel>
</UserControl>
